# Contact form delivery. All optional: with no RESEND_API_KEY the API returns
# 501 and the form opens the visitor's mail client with the message filled in.

# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where submissions land. Defaults to SITE.email in src/lib/site.ts.
CONTACT_TO=evanvoisel.official@gmail.com

# Sender address. Must be on a domain verified in Resend or the send fails.
CONTACT_FROM=portfolio@evanvoisel.com
